# ==============================================================================
# AiiDA Profile Configuration
# ==============================================================================
# Simple configuration file in KEY=VALUE format
# This file is read by setup_aiida_profile.sh

# Conda Environment
CONDA_ENV_NAME=aiida_test
CONDA_PYTHON_VERSION=3.10
CONDA_PACKAGES="aiida-vasp"
CONDA_CHANNELS=conda-forge

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=aiida_user
DB_PASSWORD=123
DB_NAME=aiida_db_new
DB_PATH=/home/shally/data/postgresql/mylocal_db_test

# RabbitMQ Configuration
RABBITMQ_VERSION=3.8.3

# User Information
USER_EMAIL=your.email@example.com
USER_FIRSTNAME=YourFirstName
USER_LASTNAME=YourLastName
USER_INSTITUTION=YourInstitution

# AiiDA Profile Settings
PROFILE_NAME=aiida_profile_test
PROFILE_SET_DEFAULT=--set-as-default
PROFILE_REPOSITORY_URI=file:///home/shally/data/aiida_profile/profile_test
